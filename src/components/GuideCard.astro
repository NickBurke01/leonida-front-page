---
import type { CollectionEntry } from 'astro:content';
import { GUIDE_CATEGORIES, NEWS_CATEGORIES } from '~/config/site';
import { formatDate, readingMinutes } from '~/lib/format';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'guides'> | CollectionEntry<'news'>;
  layout?: 'card' | 'row' | 'lead';
  headingLevel?: 'h2' | 'h3';
}
const { entry, layout = 'card', headingLevel = 'h3' } = Astro.props;
const isGuide = entry.collection === 'guides';
const href = `/${entry.collection}/${entry.id}/`;
const d = entry.data;
const category = isGuide
  ? GUIDE_CATEGORIES[d.category as keyof typeof GUIDE_CATEGORIES].label
  : NEWS_CATEGORIES[d.category as keyof typeof NEWS_CATEGORIES];
const minutes = readingMinutes(entry.body);
const H = headingLevel;
const image = d.image ?? (isGuide ? `/images/placeholders/guide-${d.category}.webp` : '/images/placeholders/news-lead.webp');
---
<article class:list={['gc', `gc--${layout}`]} data-category={d.category} data-search={`${d.title} ${d.description} ${category}`.toLowerCase()}>
  <div class="gc__media">
    <img src={image} alt={d.imageAlt ?? ''} width="1600" height="900" loading={layout === 'lead' ? 'eager' : 'lazy'} decoding="async" />
    {d.youtubeId && <span class="gc__video"><Icon name="play" size={12} />Video</span>}
  </div>
  <div class="gc__body">
    <div class="gc__pills">
      <span class="pill">{category}</span>
      {d.placeholder && <span class="pill pill--quiet">Coming with the video</span>}
    </div>
    <H class="gc__title"><a href={href}>{d.title}</a></H>
    <p class="gc__desc">{d.description}</p>
    <p class="meta">
      <time datetime={(d.updated ?? d.date).toISOString()}>{d.updated ? 'Updated ' : ''}{formatDate(d.updated ?? d.date)}</time>
      {!d.placeholder && <span>{minutes} min read</span>}
    </p>
  </div>
</article>

<style>
  .gc {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .gc:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lift);
  }
  .gc:focus-within {
    border-color: var(--amber);
  }
  .gc__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--indigo-950);
  }
  .gc__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .gc:hover .gc__media :global(img) {
    transform: scale(1.04);
  }
  .gc__video {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--crimson);
    color: var(--cream);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .gc__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--space-m);
    flex: 1;
  }
  .gc__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .gc__title {
    font-size: var(--step-2);
    line-height: 1.08;
  }
  .gc__title a {
    text-decoration: none;
  }
  /* Whole card is clickable via the title link */
  .gc__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .gc__title a:focus-visible {
    outline: none;
  }
  .gc__desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gc .meta {
    margin-top: auto;
    padding-top: 0.3rem;
  }

  /* Row layout (lists) */
  .gc--row {
    flex-direction: row;
    align-items: stretch;
  }
  .gc--row {
    align-items: center;
  }
  .gc--row .gc__media {
    flex: 0 0 42%;
    aspect-ratio: 16 / 9;
    align-self: stretch;
  }
  .gc--row .gc__media :global(img) {
    object-position: left bottom;
  }
  .gc--row .gc__title {
    font-size: var(--step-1);
  }
  @media (max-width: 640px) {
    .gc--row {
      flex-direction: column;
    }
    .gc--row .gc__media {
      aspect-ratio: 16 / 9;
    }
  }

  /* Lead story (news) */
  .gc--lead {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
  }
  .gc--lead .gc__media {
    aspect-ratio: auto;
    min-height: 320px;
  }
  .gc--lead .gc__body {
    padding: var(--space-l);
    justify-content: center;
  }
  .gc--lead .gc__title {
    font-size: var(--step-4);
  }
  .gc--lead .gc__desc {
    font-size: 1.05rem;
    -webkit-line-clamp: 4;
  }
  @media (max-width: 820px) {
    .gc--lead {
      grid-template-columns: 1fr;
    }
    .gc--lead .gc__media {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
    .gc--lead .gc__title {
      font-size: var(--step-3);
    }
  }

  /* Directions */
  :global([data-direction='a']) .gc--lead {
    background: var(--cream);
    color: var(--ink);
    border-color: transparent;
  }
  :global([data-direction='a']) .gc--lead .gc__desc,
  :global([data-direction='a']) .gc--lead .meta {
    color: #3b3446;
  }
  :global([data-direction='a']) .gc--lead .pill {
    background: var(--crimson);
    color: var(--cream);
    border-color: var(--crimson);
  }
  :global([data-direction='a']) .gc--lead .pill--quiet {
    background: transparent;
    color: #3b3446;
    border-color: rgb(11 11 16 / 0.25);
  }
  :global([data-direction='a']) .gc {
    box-shadow: none;
  }
</style>
