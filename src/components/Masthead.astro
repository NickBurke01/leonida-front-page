---
import { LONG, SHORTS, SITE } from '~/config/site';
import { editionDate } from '~/lib/format';
import { getNav } from '~/lib/nav';
import Logo from './Logo.astro';
import SubscribeButton from './SubscribeButton.astro';
import Icon from './Icon.astro';
import Search from './Search.astro';

interface Props {
  /** Home shows the big masthead; inner pages a slimmer one. */
  variant?: 'home' | 'inner';
}
const { variant = 'inner' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const built = new Date();
const nav = await getNav();
const moreActive = nav.more.some((m) => isActive(m.href));
---
<div class:list={['mh-top', `mh-top--${variant}`]}>
  <div class="wrap mh-top__inner">
    <p class="mh-edition mh-edition--left">
      <time data-edition-date datetime={built.toISOString().slice(0, 10)}>{editionDate(built)}</time>
    </p>
    <div class="mh-logo">
      <Logo size={variant === 'home' ? 'xl' : 'l'} eager />
      {variant === 'home' && <h1 class="mh-tagline">The complete picture on GTA 6</h1>}
    </div>
    <p class="mh-edition mh-edition--right">{SITE.edition} · Late City Final</p>
  </div>
  <div class="wrap"><div class="rule-double"></div></div>
</div>

<header class="mh-bar" data-mh-bar>
  <div class="wrap mh-bar__inner">
    <a class="mh-bar__mark" href="/" aria-label="Leonida Front Page, home">
      <img src="/brand/avatar-96.webp" alt="" width="34" height="34" />
      <span class="mh-bar__name">Leonida Front Page</span>
    </a>
    <nav class="mh-nav" aria-label="Main">
      <ul>
        {nav.primary.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="mh-more">
          <details data-more>
            <summary class:list={{ 'is-active': moreActive }}>More <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
            <ul class="mh-more__menu">
              {nav.more.map((item) => (
                <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>
    <div class="mh-bar__subs">
      <Search />
      <SubscribeButton channel={LONG} variant="compact" />
      <SubscribeButton channel={SHORTS} variant="compact" label="Shorts" />
    </div>
    <button class="mh-search-m" type="button" data-search-open aria-label="Search the site"><Icon name="search" size={20} /></button>
    <button class="mh-menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <Icon name="menu" size={22} />
      <span class="sr-only">Open menu</span>
    </button>
  </div>
</header>

<div class="mm" id="mobile-menu" data-menu hidden>
  <div class="mm__backdrop" data-menu-close></div>
  <div class="mm__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="mm__head">
      <Logo size="s" />
      <button class="mm__close" type="button" data-menu-close>
        <Icon name="close" size={22} />
        <span class="sr-only">Close menu</span>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul>
        {nav.all.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mm__subs">
      <p class="kicker">Watch</p>
      <SubscribeButton channel={LONG} label="Subscribe to Leonida Front Page" />
      <SubscribeButton channel={SHORTS} variant="secondary" label="Get the Daily Shorts" />
    </div>
  </div>
</div>

<script>
  // Edition date: show the visitor's today, not the build date.
  const t = document.querySelector<HTMLTimeElement>('[data-edition-date]');
  if (t) {
    const now = new Date();
    t.textContent = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(now);
    t.dateTime = now.toISOString().slice(0, 10);
  }

  // Compact bar shadow + show the small mark once the big masthead has scrolled away.
  const bar = document.querySelector<HTMLElement>('[data-mh-bar]');
  const top = document.querySelector('.mh-top');
  if (bar && top && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => bar.classList.toggle('is-stuck', !e.isIntersecting), { rootMargin: '-1px 0px 0px 0px' }).observe(top);
  }

  // Mobile menu
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const open = () => {
    if (!menu || !openBtn) return;
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add('is-open'));
    openBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
    menu.querySelector<HTMLElement>('.mm__close')?.focus();
  };
  const close = () => {
    if (!menu || !openBtn) return;
    menu.classList.remove('is-open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    setTimeout(() => (menu.hidden = true), 220);
    openBtn.focus();
  };
  openBtn?.addEventListener('click', open);

  // "More" dropdown: close on outside click / Escape.
  const more = document.querySelector<HTMLDetailsElement>('[data-more]');
  document.addEventListener('click', (e) => { if (more?.open && !more.contains(e.target as Node)) more.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && more?.open) { more.open = false; more.querySelector('summary')?.focus(); } });
  menu?.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) close();
    if (e.key === 'Tab' && menu && !menu.hidden) {
      const f = [...menu.querySelectorAll<HTMLElement>('a, button')].filter((el) => el.offsetParent !== null);
      if (!f.length) return;
      if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
    }
  });
</script>

<style>
  /* ---------- Top masthead (scrolls away) ---------- */
  .mh-top {
    position: relative;
    padding-top: var(--space-l);
    isolation: isolate;
  }
  .mh-top--home {
    padding-top: var(--space-xl);
  }
  .mh-top__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
    padding-bottom: var(--space-m);
  }
  .mh-edition {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .mh-edition--right {
    text-align: right;
  }
  .mh-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .mh-tagline {
    font-family: var(--font-head);
    font-weight: var(--head-weight);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(0.8rem, 0.7rem + 0.35vw, 1rem);
    line-height: 1.2;
    color: var(--cream-dim);
    text-align: center;
  }
  .mh-tagline::before,
  .mh-tagline::after {
    content: '—';
    margin: 0 0.6em;
    color: var(--crimson);
  }

  /* ---------- Sticky bar ---------- */
  .mh-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(13 5 34 / 0.82);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .mh-bar.is-stuck {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.9);
  }
  .mh-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: var(--masthead-h);
  }
  .mh-bar__mark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    width: 0;
    overflow: hidden;
    transition:
      opacity 0.25s var(--ease),
      visibility 0.25s,
      width 0.3s var(--ease);
  }
  .mh-bar__mark img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    flex: none;
  }
  .mh-bar__name {
    font-family: var(--font-head);
    font-weight: var(--head-weight);
    text-transform: var(--head-transform);
    font-size: 1.05rem;
    white-space: nowrap;
  }
  .is-stuck .mh-bar__mark {
    opacity: 1;
    visibility: visible;
    width: auto;
  }
  /* Tabs take the larger share of the bar (the main way around); search takes a bit under half. */
  .mh-nav {
    flex: 1.35 1 0;
    min-width: 0;
  }
  .mh-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    justify-content: space-between;
  }
  /* Each tab gets an equal slice of the tab area, so together they fill it. */
  .mh-nav > ul > li {
    flex: 1 1 0;
    display: flex;
    justify-content: center;
  }
  .mh-nav > ul > li > a,
  .mh-more summary {
    width: 100%;
    text-align: center;
    justify-content: center;
    border-radius: var(--radius-s);
  }
  .mh-nav > ul > li > a:hover,
  .mh-more summary:hover {
    background: rgb(253 242 216 / 0.05);
  }
  .mh-more details {
    width: 100%;
  }
  .mh-nav a {
    position: relative;
    display: inline-block;
    padding: 0.75rem 0.45rem;
    font-family: var(--font-ui);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-dim);
    transition: color 0.2s var(--ease);
  }
  .mh-nav a::after {
    content: '';
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: 0.3rem;
    height: 2px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .mh-nav a:hover {
    color: var(--cream);
  }
  .mh-nav a:hover::after,
  .mh-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .mh-nav a[aria-current='page'] {
    color: var(--cream);
  }
  /* The search bar stretches to fill all the space between the tabs and the subscribe buttons. */
  .mh-bar__subs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 0;
    min-width: 0;
  }
  .mh-bar__subs :global(.srch-btn) {
    flex: 1;
  }
  .mh-bar__subs :global(.sub) {
    flex: none;
  }
  .mh-more {
    position: relative;
  }
  .mh-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.75rem 0.45rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .mh-more summary::-webkit-details-marker {
    display: none;
  }
  .mh-more summary:hover,
  .mh-more summary.is-active {
    color: var(--cream);
  }
  .mh-more__menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 210px;
    padding: 0.45rem;
    display: grid !important;
    gap: 0 !important;
    list-style: none;
    background: var(--indigo-850);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-lift);
  }
  .mh-more__menu a {
    display: block !important;
    padding: 0.6rem 0.75rem !important;
    border-radius: 6px;
    letter-spacing: 0.04em !important;
    text-transform: none !important;
    font-size: 0.92rem !important;
  }
  .mh-more__menu a::after {
    display: none;
  }
  .mh-more__menu a:hover,
  .mh-more__menu a[aria-current='page'] {
    background: var(--surface-2);
    color: var(--cream);
  }
  .mh-search-m {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
  }
  .mh-menu-btn {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    place-items: center;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
  }

  /* ---------- Mobile menu ---------- */
  .mm {
    position: fixed;
    inset: 0;
    z-index: 80;
  }
  .mm__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(5 2 15 / 0.6);
    opacity: 0;
    transition: opacity 0.22s var(--ease);
  }
  .mm__panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(360px, 88vw);
    background: var(--indigo-850);
    border-left: 1px solid var(--line);
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    transform: translateX(100%);
    transition: transform 0.22s var(--ease);
    overflow-y: auto;
  }
  .mm.is-open .mm__backdrop {
    opacity: 1;
  }
  .mm.is-open .mm__panel {
    transform: none;
  }
  .mm__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mm__close {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
  }
  .mm nav ul {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .mm nav a {
    display: block;
    padding: 0.95rem 0.2rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-head);
    font-weight: var(--head-weight);
    text-transform: var(--head-transform);
    font-size: 1.5rem;
    text-decoration: none;
  }
  .mm nav a[aria-current='page'] {
    color: var(--crimson-text);
  }
  .mm__subs {
    display: grid;
    gap: 0.75rem;
  }

  /* ---------- Responsive ---------- */
  .mh-edition {
    white-space: nowrap;
  }
  /* Mid-size screens: stack the logo with the date under it, so neither wraps beside the logo. */
  @media (max-width: 1100px) {
    .mh-top__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-xs);
    }
    .mh-edition--right {
      display: none;
    }
    .mh-edition--left {
      order: 2;
    }
  }
  @media (max-width: 1080px) {
    .mh-bar__subs :global(.sub--shorts) {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .mh-top__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-xs);
    }
    .mh-edition--right {
      display: none;
    }
    .mh-edition--left {
      order: 2;
    }
    .mh-nav,
    .mh-bar__subs {
      display: none;
    }
    .mh-menu-btn {
      display: grid;
      margin-left: 0;
    }
    .mh-search-m {
      display: grid;
      margin-left: auto;
    }
    .mh-bar__mark {
      opacity: 1;
      visibility: visible;
      width: auto;
    }
    .mh-bar__inner {
      min-height: 58px;
    }
  }
  @media (max-width: 860px) {
    :global(html:not(.js)) .mh-nav {
      display: block;
      overflow-x: auto;
    }
    :global(html:not(.js)) .mh-menu-btn {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm__panel,
    .mm__backdrop,
    .mh-bar__mark {
      transition: none;
    }
  }
</style>
