---
import { type Channel, subscribeUrl } from '~/config/site';
import Icon from './Icon.astro';

interface Props {
  channel: Channel;
  variant?: 'primary' | 'secondary' | 'compact';
  label?: string;
  class?: string;
}
const { channel, variant = channel.key === 'long' ? 'primary' : 'secondary', label, class: cls } = Astro.props;
const text = label ?? (channel.key === 'long' ? 'Subscribe' : 'Daily Shorts');
---
<a
  class:list={['sub', `sub--${variant}`, `sub--${channel.key}`, cls]}
  href={subscribeUrl(channel)}
  target="_blank"
  rel="noopener"
  aria-label={`${text}: subscribe to ${channel.name} on YouTube (opens in a new tab)`}
>
  <Icon name={channel.key === 'long' ? 'bell' : 'play'} size={variant === 'compact' ? 15 : 17} />
  <span>{text}</span>
</a>

<style>
  .sub {
    --h: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: var(--h);
    padding: 0 1.15em;
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .sub:hover {
    transform: translateY(-1px);
  }
  .sub:active {
    transform: translateY(0);
  }
  .sub--primary {
    background: var(--crimson);
    color: var(--cream);
    box-shadow: 0 10px 24px -12px rgb(209 10 78 / 0.85);
  }
  .sub--primary:hover {
    background: #e2135b;
    box-shadow: 0 14px 28px -12px rgb(209 10 78 / 0.95);
  }
  .sub--secondary {
    background: transparent;
    color: var(--cream);
    border: 1.5px solid var(--line-strong);
  }
  .sub--secondary:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .sub--compact {
    --h: 36px;
    padding: 0 0.95em;
    font-size: 0.82rem;
  }
  .sub--compact.sub--long {
    background: var(--crimson);
    color: var(--cream);
  }
  .sub--compact.sub--long:hover {
    background: #e2135b;
  }
  .sub--compact.sub--shorts {
    border: 1.5px solid var(--line-strong);
  }
  .sub--compact.sub--shorts:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  :global([data-direction='a']) .sub {
    border-radius: var(--radius-s);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
</style>
