---
/**
 * Front-page sidebar: "Inside This Edition" index, "Most Watched" (real YouTube view counts; we don't
 * track readers, so we never claim "most read"), and the Vice City Forecast (a bit of fun).
 */
import type { Story } from '~/lib/home';
import { formatViews } from '~/lib/youtube';

interface Props {
  mostWatched: Story[];
}
const { mostWatched } = Astro.props;
const index = [
  ['A1', 'Front page', '#front'],
  ['A2', 'Most-watched Shorts', '#shorts'],
  ['A3', 'Latest', '#latest'],
  ['B1', 'Sections', '#sections'],
  ['B2', 'Guides', '#guides'],
  ['C1', 'The Morning Edition', '#newsletter'],
] as const;
// Dry, in-universe lines. Picked by date in the visitor's browser, so it changes daily.
const forecasts = [
  ['88°', 'Hot and humid. Wanted levels rising after dark.'],
  ['91°', 'Clear skies over the Keys. Scattered police activity downtown.'],
  ['86°', 'Sunny, with a strong chance someone takes your car.'],
  ['90°', 'Heat index high. Patience on the highway: low.'],
  ['84°', 'Afternoon storms. Good night to stay off the radar.'],
  ['89°', 'Ocean breeze on the beach. Gridlock on every causeway.'],
  ['92°', 'Scorching. Even the gators are looking for shade.'],
];
---
<aside class="sb" aria-label="This edition">
  <section class="sb__box" aria-labelledby="ite-h">
    <p class="sb__head" id="ite-h">Inside this edition</p>
    <ol class="sb__index">
      {index.map(([pg, label, href]) => (
        <li><a href={href}><span class="sb__pg">{pg}</span><span>{label}</span></a></li>
      ))}
    </ol>
  </section>

  {mostWatched.length > 0 && (
    <section class="sb__box" aria-labelledby="mw-h">
      <p class="sb__head" id="mw-h">Most watched</p>
      <ol class="sb__mw">
        {mostWatched.map((s, i) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener">
              <span class="sb__rank">{i + 1}</span>
              <span class="sb__mwtext">
                <span class="sb__mwtitle">{s.title}</span>
                <span class="sb__mwviews">{formatViews(s.views ?? 0)} · {s.kind === 'short' ? 'Short' : 'Video'}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="sb__box sb__wx" aria-labelledby="wx-h" data-forecast={JSON.stringify(forecasts)}>
    <p class="sb__head" id="wx-h">Vice City forecast</p>
    <div class="sb__wxrow">
      <svg class="sb__sun" width="46" height="46" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="10" fill="#FAB83C" /><g stroke="#E7594F" stroke-width="3" stroke-linecap="round"><path d="M24 4v6M24 38v6M4 24h6M38 24h6M9.9 9.9l4.2 4.2M33.9 33.9l4.2 4.2M9.9 38.1l4.2-4.2M33.9 14.1l4.2-4.2" /></g></svg>
      <span class="sb__temp" data-wx-temp>{forecasts[0][0]}</span>
    </div>
    <p class="sb__wxtext" data-wx-text>{forecasts[0][1]}</p>
    <p class="sb__wxfine">For entertainment only. Leonida weather may vary.</p>
  </section>
</aside>

<script>
  const box = document.querySelector<HTMLElement>('[data-forecast]');
  if (box) {
    const list = JSON.parse(box.dataset.forecast ?? '[]') as [string, string][];
    const now = new Date();
    const day = Math.floor((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - Date.UTC(now.getFullYear(), 0, 0)) / 86400000);
    const [t, text] = list[day % list.length] ?? list[0];
    box.querySelector('[data-wx-temp]')!.textContent = t;
    box.querySelector('[data-wx-text]')!.textContent = text;
  }
</script>

<style>
  .sb {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }
  .sb__box {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }
  .sb__head {
    padding-bottom: 0.55rem;
    margin-bottom: 0.4rem;
    border-bottom: 3px double var(--line-strong);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .sb__index {
    list-style: none;
    padding: 0;
  }
  .sb__index a {
    display: flex;
    gap: 0.8rem;
    padding: 0.45rem 0;
    border-bottom: 1px dotted var(--line);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--text-dim);
  }
  .sb__index li:last-child a {
    border-bottom: 0;
  }
  .sb__index a:hover {
    color: var(--cream);
  }
  .sb__pg {
    min-width: 2.2rem;
    font-weight: 700;
    color: var(--crimson-text);
  }
  .sb__mw {
    list-style: none;
    padding: 0;
  }
  .sb__mw a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.6rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .sb__mw li:last-child a {
    border-bottom: 0;
  }
  .sb__rank {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--crimson-text);
  }
  .sb__mwtext {
    display: grid;
    gap: 0.15rem;
  }
  .sb__mwtitle {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sb__mw a:hover .sb__mwtitle {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .sb__mwviews {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--teal);
  }
  .sb__wx {
    background:
      radial-gradient(80% 90% at 100% 0%, rgb(250 184 60 / 0.16), transparent 60%),
      var(--surface);
  }
  .sb__wxrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }
  .sb__temp {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
  }
  .sb__wxtext {
    margin-top: 0.5rem;
    font-family: var(--font-body);
    color: var(--text-dim);
  }
  .sb__wxfine {
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    color: var(--text-mute);
  }
</style>
