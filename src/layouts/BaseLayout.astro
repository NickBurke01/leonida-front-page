---
import { Font } from 'astro:assets';
import '~/styles/global.css';
import { SITE } from '~/config/site';
import { CHROME, PAGE_STYLE, type PageKind } from '~/config/theme';
import { absolute, organization, website } from '~/lib/seo';
import Masthead from '~/components/Masthead.astro';
import Ticker from '~/components/Ticker.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path to the share image (defaults to the brand share image). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  masthead?: 'home' | 'inner';
  published?: Date;
  modified?: Date;
  /** Include this page in the on-site search (separate from Google: unfinished pages are still searchable). */
  search?: boolean;
  /** Which type of page this is; decides its visual style (see config/theme.ts). */
  kind?: PageKind;
}
const { title, description, image = '/og-default.png', imageAlt = `${SITE.name}: ${SITE.tagline}`, type = 'website', noindex = false, jsonLd = [], masthead = 'inner', published, modified, search = true, kind = 'page' } = Astro.props;
const pageStyle = PAGE_STYLE[kind];

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = absolute(image);
const schema = [organization(), website(), ...jsonLd];
const dev = import.meta.env.DEV;

// Each page loads only the fonts it uses: the chrome's (top bar, footer) plus its own style's.
const fontsByStyle = {
  a: ['--font-oswald', '--font-newsreader'],
  b: ['--font-barlow-condensed', '--font-inter'],
} as const;
const fonts = [...new Set([...fontsByStyle[CHROME], ...fontsByStyle[pageStyle]])];
// Preload only the single headline weight each page shows first (nav + page heading); everything else loads on demand.
const preloads: Record<string, { weight: string }[]> = { '--font-oswald': [{ weight: '600' }] };
if (pageStyle === 'b') preloads['--font-barlow-condensed'] = [{ weight: '700' }];
---
<!doctype html>
<html lang="en" data-direction={pageStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0D0522" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={SITE.locale} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {fonts.map((v) => <Font cssVariable={v} preload={!dev && preloads[v] ? preloads[v] : false} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="chrome" data-direction={CHROME}>
      <Masthead variant={masthead} />
      <Ticker />
    </div>
    <main id="main" tabindex="-1" data-pagefind-body={search ? '' : undefined}>
      <slot />
    </main>
    <div class="chrome" data-direction={CHROME}>
      <Footer />
    </div>

    <script>
      // Gentle reveal on scroll. Content is fully visible without JavaScript.
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
